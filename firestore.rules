rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function room(c) { return get(/databases/$(database)/documents/rooms/$(c)).data; }
  function member(c) { return signed() && exists(/databases/$(database)/documents/rooms/$(c)/players/$(request.auth.uid)); }
  function host(c) { return member(c) && room(c).hostId == request.auth.uid; }
  function active(c,r) { return room(c).status == 'PLAYING' && room(c).currentRoundId == r; }
  function rnd(c,r) { return get(/databases/$(database)/documents/rooms/$(c)/rounds/$(r)).data; }
  function cleanup(c,r) { return host(c) && rnd(c,r).state == 'RESULT' && getAfter(/databases/$(database)/documents/rooms/$(c)).data.currentRoundId != r; }
  function text(v,n) { return v is string && v.size() > 0 && v.size() <= n; }
  function permutation(a,b) { return a is list && a.size() == b.size() && a.toSet() == b.toSet(); }
  function ready(c,r,ids,i) { return ids.size() <= i || exists(/databases/$(database)/documents/rooms/$(c)/rounds/$(r)/ready/$(ids[i])); }
  function allReady(c,r,ids) { return ready(c,r,ids,0) && ready(c,r,ids,1) && ready(c,r,ids,2) && ready(c,r,ids,3) && ready(c,r,ids,4) && ready(c,r,ids,5) && ready(c,r,ids,6) && ready(c,r,ids,7); }
  function alibiMember(c) { return signed() && exists(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.auth.uid)); }
  function alibiRoom(c) { return get(/databases/$(database)/documents/alibiRooms/$(c)).data; }
  function alibiHost(c) { return alibiMember(c) && alibiRoom(c).hostId == request.auth.uid; }
  function adsMember(c) { return signed() && exists(/databases/$(database)/documents/adsRooms/$(c)/players/$(request.auth.uid)); }
  function adsRoom(c) { return get(/databases/$(database)/documents/adsRooms/$(c)).data; }
  match /adsInvites/{c} {
   allow get: if signed();
   allow list: if false;
   allow create: if signed() && c.matches('^[A-HJ-NP-Z2-9]{5}$')
    && request.resource.data.keys().hasOnly(['count','open']) && request.resource.data.count == 1 && request.resource.data.open == true
    && getAfter(/databases/$(database)/documents/adsRooms/$(c)).data.hostId == request.auth.uid
    && getAfter(/databases/$(database)/documents/adsRooms/$(c)/players/$(request.auth.uid)).data.uid == request.auth.uid;
   allow update: if signed() && resource.data.open == true && resource.data.count < 8
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
    && request.resource.data.count == resource.data.count + 1
    && !exists(/databases/$(database)/documents/adsRooms/$(c)/players/$(request.auth.uid))
    && getAfter(/databases/$(database)/documents/adsRooms/$(c)/players/$(request.auth.uid)).data.uid == request.auth.uid;
   allow delete: if false;
  }
  match /adsRooms/{c} {
   allow read: if adsMember(c);
   allow create: if signed() && request.resource.data.keys().hasOnly(['code','hostId','phase','mode','sellerCount'])
    && request.resource.data.code == c && request.resource.data.hostId == request.auth.uid
    && request.resource.data.phase == 'lobby' && request.resource.data.mode in ['online','presencial'] && request.resource.data.sellerCount == 2
    && getAfter(/databases/$(database)/documents/adsInvites/$(c)).data.count == 1
    && getAfter(/databases/$(database)/documents/adsRooms/$(c)/players/$(request.auth.uid)).data.uid == request.auth.uid;
   allow update: if adsMember(c) && adsRoom(c).hostId == request.auth.uid && resource.data.phase == 'lobby'
    && resource.data.mode == 'presencial' && get(/databases/$(database)/documents/adsInvites/$(c)).data.count >= 5
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sellerCount']) && request.resource.data.sellerCount in [2,3];
   allow delete: if false;
   // Private assignments are deliberately separate from the public round.
   // Round creation and transitions remain disabled until the complete game is implemented.
   match /rounds/{r} {
    function currentAdsRound() { return adsRoom(c).currentRoundId == r; }
    function adRound() { return get(/databases/$(database)/documents/adsRooms/$(c)/rounds/$(r)).data; }
    allow read: if adsMember(c) && currentAdsRound();
    allow write: if false;
    match /styles/{uid} {
     allow get: if adsMember(c) && currentAdsRound() && (uid == request.auth.uid || adRound().phase == 'result');
     allow list: if adsMember(c) && currentAdsRound() && adRound().phase == 'result';
     allow create: if adsMember(c) && currentAdsRound() && request.auth.uid == uid
      && adRound().phase == 'preparation' && uid in adRound().authors
      && request.resource.data.keys().hasOnly(['uid','style']) && request.resource.data.uid == uid
      && request.resource.data.style is int && request.resource.data.style >= 0 && request.resource.data.style < 8
      && getAfter(/databases/$(database)/documents/adsRooms/$(c)/rounds/$(r)/styleSlots/$(string(request.resource.data.style))).data.uid == uid;
     allow update, delete: if false;
    }
    match /styleSlots/{slot} {
     allow read: if false;
     allow create: if adsMember(c) && currentAdsRound() && adRound().phase == 'preparation'
      && request.auth.uid in adRound().authors && slot.matches('^[0-7]$')
      && request.resource.data.keys().hasOnly(['uid','style']) && request.resource.data.uid == request.auth.uid
      && request.resource.data.style is int && slot == string(request.resource.data.style)
      && getAfter(/databases/$(database)/documents/adsRooms/$(c)/rounds/$(r)/styles/$(request.auth.uid)).data.style == request.resource.data.style;
     allow update, delete: if false;
    }
    match /authorIndex/{uid} {
     allow get: if adsMember(c) && currentAdsRound() && (uid == request.auth.uid || adRound().phase == 'result');
     allow list: if adsMember(c) && currentAdsRound() && adRound().phase == 'result';
     allow create: if adsMember(c) && currentAdsRound() && uid == request.auth.uid
      && adRound().mode == 'online' && adRound().phase == 'creation' && uid in adRound().authors
      && request.time < adRound().startedAt + duration.value(40,'s')
      && request.resource.data.keys().hasOnly(['uid','adId']) && request.resource.data.uid == uid
      && request.resource.data.adId is string && request.resource.data.adId.matches('^[A-Za-z0-9]{20}$')
      && getAfter(/databases/$(database)/documents/adsRooms/$(c)/rounds/$(r)/ads/$(request.resource.data.adId)).data.id == request.resource.data.adId;
     allow update, delete: if false;
    }
    match /ads/{adId} {
     allow get: if adsMember(c) && currentAdsRound() && (adRound().phase in ['vote','result']
      || (exists(/databases/$(database)/documents/adsRooms/$(c)/rounds/$(r)/authorIndex/$(request.auth.uid))
       && get(/databases/$(database)/documents/adsRooms/$(c)/rounds/$(r)/authorIndex/$(request.auth.uid)).data.adId == adId));
     allow list: if adsMember(c) && currentAdsRound() && adRound().phase in ['vote','result'];
     allow create: if adsMember(c) && currentAdsRound() && adRound().mode == 'online'
      && adRound().phase == 'creation' && request.auth.uid in adRound().authors
      && request.time < adRound().startedAt + duration.value(40,'s')
      && request.resource.data.keys().hasOnly(['id','title','description']) && request.resource.data.id == adId
      && adId.matches('^[A-Za-z0-9]{20}$') && text(request.resource.data.title,80) && text(request.resource.data.description,280)
      && getAfter(/databases/$(database)/documents/adsRooms/$(c)/rounds/$(r)/authorIndex/$(request.auth.uid)).data.adId == adId;
     allow update, delete: if false;
    }
    match /writtenVotes/{uid} {
     allow get: if adsMember(c) && currentAdsRound() && (uid == request.auth.uid || adRound().phase == 'result');
     allow list: if adsMember(c) && currentAdsRound() && adRound().phase == 'result';
     allow create: if adsMember(c) && currentAdsRound() && request.auth.uid == uid
      && adRound().mode == 'online' && adRound().phase == 'vote' && uid in adRound().voters
      && request.time < adRound().voteStartedAt + duration.value(30,'s')
      && request.resource.data.keys().hasOnly(['uid','adId']) && request.resource.data.uid == uid
      && request.resource.data.adId in adRound().validAdIds && adRound().validAdIds.size() >= 2
      && exists(/databases/$(database)/documents/adsRooms/$(c)/rounds/$(r)/ads/$(request.resource.data.adId))
      && (!exists(/databases/$(database)/documents/adsRooms/$(c)/rounds/$(r)/authorIndex/$(uid))
       || get(/databases/$(database)/documents/adsRooms/$(c)/rounds/$(r)/authorIndex/$(uid)).data.adId != request.resource.data.adId);
     allow update, delete: if false;
    }
    match /presentationVotes/{voteId} {
     allow get: if adsMember(c) && currentAdsRound() && (resource.data.uid == request.auth.uid || adRound().phase == 'result');
     allow list: if adsMember(c) && currentAdsRound() && adRound().phase == 'result';
     allow create: if adsMember(c) && currentAdsRound() && adRound().mode == 'presencial'
      && adRound().phase == 'vote' && request.auth.uid in adRound().audience
      && request.time < adRound().voteStartedAt + duration.value(20,'s')
      && request.resource.data.keys().hasOnly(['uid','presentation','choice']) && request.resource.data.uid == request.auth.uid
      && request.resource.data.presentation == adRound().presentationIndex
      && voteId == string(adRound().presentationIndex) + '_' + request.auth.uid
      && request.resource.data.choice in ['compro','nao-compro'];
     allow update, delete: if false;
    }
   }
   match /players/{uid} {
    allow get: if signed() && (uid == request.auth.uid || adsMember(c));
    allow list: if adsMember(c);
    allow create: if signed() && uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid','name','joinedAt'])
     && request.resource.data.uid == uid && text(request.resource.data.name,24) && request.resource.data.joinedAt == request.time
     && getAfter(/databases/$(database)/documents/adsRooms/$(c)).data.phase == 'lobby'
     && getAfter(/databases/$(database)/documents/adsInvites/$(c)).data.open == true
     && ((!exists(/databases/$(database)/documents/adsInvites/$(c)) && getAfter(/databases/$(database)/documents/adsInvites/$(c)).data.count == 1
       && getAfter(/databases/$(database)/documents/adsRooms/$(c)).data.hostId == uid)
      || (exists(/databases/$(database)/documents/adsInvites/$(c)) && get(/databases/$(database)/documents/adsInvites/$(c)).data.count < 8
       && getAfter(/databases/$(database)/documents/adsInvites/$(c)).data.count == get(/databases/$(database)/documents/adsInvites/$(c)).data.count + 1));
    allow update, delete: if false;
   }
  }
  match /alibiInvites/{c} {
   allow get: if signed();
   allow list: if false;
   allow create: if signed() && c.matches('^[A-HJ-NP-Z2-9]{5}$')
    && request.resource.data.keys().hasOnly(['count','open'])
    && request.resource.data.count == 1 && request.resource.data.open == true
    && getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.hostId == request.auth.uid
    && getAfter(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.auth.uid)).data.uid == request.auth.uid;
   allow update: if signed() && resource.data.open == true && resource.data.count < 8
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
    && request.resource.data.count == resource.data.count + 1
    && !exists(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.auth.uid))
    && getAfter(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.auth.uid)).data.uid == request.auth.uid;
   allow update: if alibiMember(c) && resource.data.count > 0
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count','open'])
    && request.resource.data.count == resource.data.count - 1
    && request.resource.data.open == (request.resource.data.count > 0)
    && !existsAfter(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.auth.uid));
   allow delete: if false;
  }
  match /alibiRooms/{c} {
   allow read: if alibiMember(c);
   allow create: if signed() && request.resource.data.keys().hasOnly(['code','hostId','phase','mode'])
    && request.resource.data.code == c && request.resource.data.hostId == request.auth.uid
    && request.resource.data.phase == 'lobby' && request.resource.data.get('mode','online') in ['online','presencial']
    && getAfter(/databases/$(database)/documents/alibiInvites/$(c)).data.count == 1
    && getAfter(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.auth.uid)).data.uid == request.auth.uid;
   allow update: if alibiHost(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase','currentRoundId'])
    && ((resource.data.phase == 'lobby' && request.resource.data.phase == 'playing'
      && text(request.resource.data.currentRoundId,80)
      && getAfter(/databases/$(database)/documents/alibiRooms/$(c)/rounds/$(request.resource.data.currentRoundId)).data.phase == 'presentation')
     || (resource.data.phase == 'playing' && request.resource.data.phase == 'lobby'
      && request.resource.data.currentRoundId == resource.data.currentRoundId
      && getAfter(/databases/$(database)/documents/alibiRooms/$(c)/rounds/$(resource.data.currentRoundId)).data.phase in ['result','cancelled']));
   allow update: if alibiMember(c) && resource.data.phase == 'playing'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase'])
    && request.resource.data.phase == 'lobby'
    && getAfter(/databases/$(database)/documents/alibiRooms/$(c)/rounds/$(resource.data.currentRoundId)).data.phase == 'result';
   allow update: if alibiMember(c)
    && !existsAfter(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.auth.uid))
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostId','phase'])
    && request.resource.data.phase == 'lobby'
    && getAfter(/databases/$(database)/documents/alibiInvites/$(c)).data.count == get(/databases/$(database)/documents/alibiInvites/$(c)).data.count - 1
    && (resource.data.phase == 'lobby' || getAfter(/databases/$(database)/documents/alibiRooms/$(c)/rounds/$(resource.data.currentRoundId)).data.phase == 'cancelled')
    && ((resource.data.hostId != request.auth.uid && request.resource.data.hostId == resource.data.hostId)
     || (resource.data.hostId == request.auth.uid && ((getAfter(/databases/$(database)/documents/alibiInvites/$(c)).data.count == 0 && request.resource.data.hostId == '')
      || (getAfter(/databases/$(database)/documents/alibiInvites/$(c)).data.count > 0 && request.resource.data.hostId != request.auth.uid
       && existsAfter(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.resource.data.hostId))))));
   allow delete: if false;
   match /clock/{uid} {
    allow read: if alibiMember(c);
    allow create, update: if alibiMember(c) && request.auth.uid == uid
     && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
    allow delete: if false;
   }
   // Reserved for the Firestore-only round implementation. A response or vote
   // is immutable and only its owner can read it until the relevant reveal.
   match /rounds/{r} {
    function currentRound() { return get(/databases/$(database)/documents/alibiRooms/$(c)).data.currentRoundId == r; }
    function game() { return get(/databases/$(database)/documents/alibiRooms/$(c)/rounds/$(r)).data; }
    allow read: if alibiMember(c);
    allow create: if alibiHost(c) && alibiRoom(c).phase == 'lobby'
     && getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.currentRoundId == r
     && getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.phase == 'playing'
     && request.resource.data.keys().hasOnly(['id','phase','mode','catalogId','situation','suspects','investigator','jurors','submitted','voted','customQuestion','startedAt','surpriseAt','voteStartedAt','history','used'])
     && request.resource.data.id == r && request.resource.data.phase == 'presentation'
     && request.resource.data.get('mode','online') == alibiRoom(c).get('mode','online')
     && text(request.resource.data.catalogId,80) && text(request.resource.data.situation,500)
     && request.resource.data.suspects is list && request.resource.data.suspects.size() == 2
     && request.resource.data.suspects.toSet().size() == 2
     && exists(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.resource.data.suspects[0]))
     && exists(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.resource.data.suspects[1]))
     && request.resource.data.jurors is list && request.resource.data.jurors.size() <= 5
     && request.resource.data.jurors.toSet().size() == request.resource.data.jurors.size()
     && request.resource.data.suspects.toSet().intersection(request.resource.data.jurors.toSet()).size() == 0
     && ((request.resource.data.investigator == null && request.resource.data.jurors.size() == 0
       && get(/databases/$(database)/documents/alibiInvites/$(c)).data.count == 2)
      || (request.resource.data.investigator is string && !(request.resource.data.investigator in request.resource.data.suspects)
       && !(request.resource.data.investigator in request.resource.data.jurors)
       && exists(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.resource.data.investigator))
       && get(/databases/$(database)/documents/alibiInvites/$(c)).data.count == request.resource.data.jurors.size() + 3))
     && request.resource.data.submitted == [] && request.resource.data.voted == []
     && request.resource.data.customQuestion == '' && request.resource.data.startedAt == null
     && request.resource.data.surpriseAt == null && request.resource.data.voteStartedAt == null
     && request.resource.data.history is map && request.resource.data.used is list;
    allow update: if alibiMember(c) && currentRound() && (
     (alibiHost(c) && resource.data.phase == 'presentation' && request.resource.data.phase == 'timer'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase','startedAt']) && request.resource.data.startedAt == request.time)
     || (resource.data.phase == 'timer' && request.time >= resource.data.startedAt + duration.value(30,'s')
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase','surpriseAt'])
      && ((resource.data.get('mode','online') == 'presencial' && request.resource.data.surpriseAt == null
        && ((resource.data.jurors.size() > 0 && request.resource.data.phase == 'oralSetup')
         || (resource.data.jurors.size() == 0 && request.resource.data.phase == 'oralFirst')))
       || (resource.data.get('mode','online') == 'online' && ((resource.data.investigator == null && request.resource.data.phase == 'answers' && request.resource.data.surpriseAt == null)
        || (resource.data.investigator != null && request.resource.data.phase == 'surprise' && request.resource.data.surpriseAt == request.time)))))
     || (resource.data.get('mode','online') == 'presencial' && resource.data.phase == 'oralSetup' && request.resource.data.phase == 'oralFirst'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase','customQuestion'])
      && request.resource.data.customQuestion is string && request.resource.data.customQuestion.size() <= 200
      && (request.auth.uid == resource.data.investigator || (alibiHost(c) && request.resource.data.customQuestion == '')))
     || (resource.data.get('mode','online') == 'presencial'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase'])
      && ((resource.data.phase == 'oralFirst' && request.resource.data.phase == 'oralSecond'
         && (alibiHost(c) || request.auth.uid == resource.data.suspects[0] || request.auth.uid == resource.data.investigator))
       || (resource.data.phase == 'oralSecond' && request.resource.data.phase == 'reveal'
         && (alibiHost(c) || request.auth.uid == resource.data.suspects[1] || request.auth.uid == resource.data.investigator))))
     || (resource.data.get('mode','online') == 'online' && resource.data.phase == 'surprise' && request.resource.data.phase == 'answers'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase','customQuestion'])
      && request.resource.data.customQuestion is string && request.resource.data.customQuestion.size() <= 200
      && ((request.auth.uid == resource.data.investigator && request.time < resource.data.surpriseAt + duration.value(15,'s'))
       || (request.time >= resource.data.surpriseAt + duration.value(15,'s') && request.resource.data.customQuestion == '')))
     || (resource.data.get('mode','online') == 'online' && resource.data.phase == 'answers' && request.resource.data.phase == 'answers'
      && request.auth.uid in resource.data.suspects && !(request.auth.uid in resource.data.submitted)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submitted'])
      && request.resource.data.submitted.size() == resource.data.submitted.size() + 1
      && request.resource.data.submitted.toSet() == resource.data.submitted.toSet().union([request.auth.uid].toSet())
      && getAfter(/databases/$(database)/documents/alibiRooms/$(c)/rounds/$(r)/answers/$(request.auth.uid)).data.uid == request.auth.uid)
     || (resource.data.get('mode','online') == 'online' && resource.data.phase == 'answers' && request.resource.data.phase == 'reveal'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase'])
      && resource.data.submitted.toSet() == resource.data.suspects.toSet())
     || (alibiHost(c) && resource.data.phase == 'reveal' && request.resource.data.phase == 'vote'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase','voteStartedAt']) && request.resource.data.voteStartedAt == request.time)
     || (resource.data.phase == 'vote' && request.resource.data.phase == 'vote' && !(request.auth.uid in resource.data.voted)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voted'])
      && request.resource.data.voted.size() == resource.data.voted.size() + 1
      && request.resource.data.voted.toSet() == resource.data.voted.toSet().union([request.auth.uid].toSet())
      && getAfter(/databases/$(database)/documents/alibiRooms/$(c)/rounds/$(r)/votes/$(request.auth.uid)).data.uid == request.auth.uid)
     || (resource.data.phase == 'vote' && request.resource.data.phase == 'result'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase'])
      && ((resource.data.investigator == null && alibiHost(c))
       || (resource.data.investigator != null && (request.time >= resource.data.voteStartedAt + duration.value(30,'s')
        || (resource.data.jurors.size() == 0 && resource.data.investigator in resource.data.voted)
        || (resource.data.jurors.size() > 0 && resource.data.voted.toSet() == resource.data.jurors.toSet()))))
      && getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.phase == 'lobby')
     || (alibiHost(c) && !(resource.data.phase in ['result','cancelled']) && request.resource.data.phase == 'cancelled'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase'])
      && getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.phase == 'lobby')
     || (!(resource.data.phase in ['result','cancelled']) && request.resource.data.phase == 'cancelled'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase'])
      && !existsAfter(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.auth.uid))
      && getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.phase == 'lobby'));
    allow delete: if false;
    match /answers/{uid} {
     allow get: if alibiMember(c) && currentRound()
      && (request.auth.uid == uid || game().phase in ['reveal','vote','result']);
     allow list: if alibiMember(c) && currentRound() && game().phase in ['reveal','vote','result'];
     allow create: if alibiMember(c) && currentRound() && request.auth.uid == uid
      && game().get('mode','online') == 'online' && game().phase == 'answers' && uid in game().suspects
      && request.resource.data.keys().hasOnly(['uid','values'])
      && request.resource.data.uid == uid && request.resource.data.values is list
      && request.resource.data.values.size() == 3
      && text(request.resource.data.values[0],500)
      && text(request.resource.data.values[1],500)
      && text(request.resource.data.values[2],500)
      && request.auth.uid in getAfter(/databases/$(database)/documents/alibiRooms/$(c)/rounds/$(r)).data.submitted;
     allow update, delete: if false;
    }
    match /votes/{uid} {
     allow get: if alibiMember(c) && currentRound()
      && (request.auth.uid == uid || game().phase == 'result');
     allow list: if alibiMember(c) && currentRound() && game().phase == 'result';
     allow create: if alibiMember(c) && currentRound() && request.auth.uid == uid
      && game().phase == 'vote'
      && (uid in game().jurors || (game().jurors.size() == 0
        && ((game().investigator != null && uid == game().investigator)
         || (game().investigator == null && uid == get(/databases/$(database)/documents/alibiRooms/$(c)).data.hostId))))
      && (game().investigator == null || request.time < game().voteStartedAt + duration.value(30, 's'))
      && request.resource.data.keys().hasOnly(['uid','choice']) && request.resource.data.uid == uid
      && request.resource.data.choice in ['colou','furado']
      && request.auth.uid in getAfter(/databases/$(database)/documents/alibiRooms/$(c)/rounds/$(r)).data.voted;
     allow update, delete: if false;
    }
   }
   match /players/{uid} {
    allow get: if signed() && (uid == request.auth.uid || alibiMember(c));
    allow list: if alibiMember(c);
    allow create: if signed() && uid == request.auth.uid
     && request.resource.data.keys().hasOnly(['uid','name','joinedAt'])
     && request.resource.data.uid == uid && text(request.resource.data.name,24)
     && request.resource.data.joinedAt == request.time
     && getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.phase == 'lobby'
     && getAfter(/databases/$(database)/documents/alibiInvites/$(c)).data.open == true
     && ((!exists(/databases/$(database)/documents/alibiInvites/$(c))
       && getAfter(/databases/$(database)/documents/alibiInvites/$(c)).data.count == 1
       && getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.hostId == uid)
      || (exists(/databases/$(database)/documents/alibiInvites/$(c))
       && get(/databases/$(database)/documents/alibiInvites/$(c)).data.count < 8
       && getAfter(/databases/$(database)/documents/alibiInvites/$(c)).data.count == get(/databases/$(database)/documents/alibiInvites/$(c)).data.count + 1));
    allow delete: if alibiMember(c) && request.auth.uid == uid
     && getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.phase == 'lobby'
     && (alibiRoom(c).hostId != uid || getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.hostId != uid)
     && getAfter(/databases/$(database)/documents/alibiInvites/$(c)).data.count == get(/databases/$(database)/documents/alibiInvites/$(c)).data.count - 1;
    allow update: if false;
   }
  }
  match /rooms/{c} {
   function playerDoc(c,u) { return /databases/$(database)/documents/rooms/$(c)/players/$(u); }
   // Host takeover after a prolonged disconnection: the host's player document
   // is gone, or it says connected == false and its server-stamped presenceAt is
   // older than 3 minutes (HOST_TAKEOVER_MINUTES in src/utils/game.ts).
   function hostAway(h) { return !exists(playerDoc(c,h))
    || (get(playerDoc(c,h)).data.connected == false && get(playerDoc(c,h)).data.get('presenceAt', null) is timestamp
     && request.time > get(playerDoc(c,h)).data.presenceAt + duration.value(3, 'm')); }
   function onlyKeys(k) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(k); }
   // Exact code lookup is necessary to join. Listing/enumeration is forbidden.
   allow get: if signed();
   allow list: if false;
   allow create: if signed() && c.matches('^[A-HJ-NP-Z2-9]{5}$')
    && request.resource.data.keys().hasOnly(['code','hostId','status','roundNo','currentRoundId','createdAt','mode','deal'])
    && ((request.resource.data.get('mode','ONLINE') == 'ONLINE' && !request.resource.data.keys().hasAny(['deal']))
     || (request.resource.data.get('mode','ONLINE') == 'IN_PERSON' && request.resource.data.deal == 0))
    && request.resource.data.code == c && request.resource.data.hostId == request.auth.uid
    && request.resource.data.status == 'LOBBY' && request.resource.data.roundNo == 0
    && request.resource.data.currentRoundId == '' && request.resource.data.createdAt == request.time;
   allow update: if host(c) && resource.data.get('mode','ONLINE') == 'ONLINE' && resource.data.status != 'CLOSED' && (
    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'CLOSED') ||
    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','roundNo','currentRoundId'])
     && request.resource.data.status == 'PLAYING' && request.resource.data.roundNo == resource.data.roundNo + 1
     && request.resource.data.currentRoundId == string(request.resource.data.roundNo)
     && (resource.data.status == 'LOBBY' || rnd(c,resource.data.currentRoundId).state == 'RESULT')
     && getAfter(/databases/$(database)/documents/rooms/$(c)/rounds/$(request.resource.data.currentRoundId)).data.state == 'WAITING_FOR_THEME'));
   // Host abandons the current round and returns to the lobby (a participant left, etc.).
   allow update: if host(c) && resource.data.get('mode','ONLINE') == 'ONLINE' && resource.data.status == 'PLAYING'
    && onlyKeys(['status','currentRoundId']) && request.resource.data.status == 'LOBBY' && request.resource.data.currentRoundId == '';
   // Voluntary host exit: in the same commit the host deletes its own player document
   // and hands hostId to another existing member (optionally returning to the lobby).
   allow update: if host(c) && resource.data.get('mode','ONLINE') == 'ONLINE' && resource.data.status != 'CLOSED'
    && onlyKeys(['hostId','status','currentRoundId'])
    && request.resource.data.hostId != request.auth.uid && request.resource.data.hostId is string
    && exists(playerDoc(c,request.resource.data.hostId)) && existsAfter(playerDoc(c,request.resource.data.hostId))
    && !existsAfter(playerDoc(c,request.auth.uid))
    && ((request.resource.data.status == resource.data.status && request.resource.data.currentRoundId == resource.data.currentRoundId)
     || (resource.data.status == 'PLAYING' && request.resource.data.status == 'LOBBY' && request.resource.data.currentRoundId == ''));
   // Takeover: a connected member claims hostId for itself while the current host is away.
   allow update: if member(c) && resource.data.get('mode','ONLINE') == 'ONLINE' && resource.data.status != 'CLOSED'
    && onlyKeys(['hostId']) && request.resource.data.hostId == request.auth.uid
    && resource.data.hostId != request.auth.uid
    && get(playerDoc(c,request.auth.uid)).data.connected == true
    && hostAway(resource.data.hostId);
   allow delete: if false;
   allow update: if host(c) && resource.data.get('mode','ONLINE') == 'IN_PERSON' && resource.data.status == 'LOBBY'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deal'])
    && request.resource.data.deal == resource.data.deal + 1;
   match /cards/{uid} {
    allow get: if member(c) && request.auth.uid == uid && room(c).get('mode','ONLINE') == 'IN_PERSON';
    allow list: if false;
    allow create, update: if member(c) && request.auth.uid == uid
     && room(c).get('mode','ONLINE') == 'IN_PERSON' && room(c).status == 'LOBBY'
     && request.resource.data.keys().hasOnly(['uid','deal','number'])
     && request.resource.data.uid == uid && room(c).deal > 0 && request.resource.data.deal == room(c).deal
     && request.resource.data.number is int && request.resource.data.number >= 1 && request.resource.data.number <= 100
     && (!exists(/databases/$(database)/documents/rooms/$(c)/cards/$(uid)) || resource.data.deal < room(c).deal);
    allow delete: if false;
   }
   match /players/{uid} {
    allow get: if signed() && (request.auth.uid == uid || member(c));
    allow list: if member(c);
    allow create: if signed() && request.auth.uid == uid
     && getAfter(/databases/$(database)/documents/rooms/$(c)).data.status == 'LOBBY'
     && request.resource.data.keys().hasOnly(['uid','name','connected','joinedAt','presenceAt'])
     && request.resource.data.uid == uid && text(request.resource.data.name,24)
     && request.resource.data.connected == true && request.resource.data.joinedAt == request.time
     && request.resource.data.get('presenceAt', request.time) == request.time;
    allow update: if member(c) && request.auth.uid == uid && room(c).status != 'CLOSED'
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['connected','presenceAt'])
     && request.resource.data.connected is bool
     && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['presenceAt']) || request.resource.data.presenceAt == request.time);
    allow delete: if host(c) && room(c).status == 'LOBBY' && uid != room(c).hostId;
    // Voluntary exit (ONLINE): a member removes itself. The host must hand over
    // hostId in the same commit, or close the room when it is the last one.
    allow delete: if member(c) && request.auth.uid == uid && room(c).get('mode','ONLINE') == 'ONLINE'
     && room(c).status != 'CLOSED'
     && (room(c).hostId != uid
      || getAfter(/databases/$(database)/documents/rooms/$(c)).data.hostId != uid
      || getAfter(/databases/$(database)/documents/rooms/$(c)).data.status == 'CLOSED');
   }
   match /rounds/{r} {
    allow read: if member(c);
    allow create: if host(c) && room(c).get('mode','ONLINE') == 'ONLINE' && request.resource.data.keys().hasOnly(['state','theme','lowLabel','highLabel','playerIds','presentationOrder','currentPresentationIndex','groupOrder','createdAt'])
     && getAfter(/databases/$(database)/documents/rooms/$(c)).data.currentRoundId == r
     && r == string(room(c).roundNo + 1)
     && (room(c).status == 'LOBBY' || rnd(c,room(c).currentRoundId).state == 'RESULT')
     && request.resource.data.state == 'WAITING_FOR_THEME'
     && request.resource.data.theme == '' && request.resource.data.lowLabel == '' && request.resource.data.highLabel == ''
     && request.resource.data.playerIds is list && request.resource.data.playerIds.size() >= 2 && request.resource.data.playerIds.size() <= 8
     && request.resource.data.playerIds.toSet().size() == request.resource.data.playerIds.size()
     && request.auth.uid in request.resource.data.playerIds
     && request.resource.data.presentationOrder == request.resource.data.playerIds && request.resource.data.groupOrder == request.resource.data.playerIds
     && request.resource.data.currentPresentationIndex == 0 && request.resource.data.createdAt == request.time;
    allow update: if host(c) && active(c,r) && (
     (resource.data.state == 'WAITING_FOR_THEME' && request.resource.data.state == 'DISTRIBUTING_NUMBERS'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','theme','lowLabel','highLabel'])
      && text(request.resource.data.theme,120) && text(request.resource.data.lowLabel,40) && text(request.resource.data.highLabel,40)) ||
     (resource.data.state == 'DISTRIBUTING_NUMBERS' && request.resource.data.state == 'PRESENTING'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','presentationOrder'])
      && permutation(request.resource.data.presentationOrder,resource.data.playerIds) && allReady(c,r,resource.data.playerIds)) ||
     (resource.data.state == 'PRESENTING'
      && exists(/databases/$(database)/documents/rooms/$(c)/rounds/$(r)/answers/$(resource.data.presentationOrder[resource.data.currentPresentationIndex]))
      && ((request.resource.data.state == 'PRESENTING' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentPresentationIndex'])
       && request.resource.data.currentPresentationIndex == resource.data.currentPresentationIndex + 1 && request.resource.data.currentPresentationIndex < resource.data.playerIds.size())
       || (request.resource.data.state == 'ORDERING' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state']) && resource.data.currentPresentationIndex == resource.data.playerIds.size() - 1))) ||
     (resource.data.state == 'ORDERING' && request.resource.data.state == 'ORDERING' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupOrder']) && permutation(request.resource.data.groupOrder,resource.data.playerIds)) ||
     (resource.data.state == 'ORDERING' && request.resource.data.state == 'READY_FOR_RESULT' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state'])) ||
     (resource.data.state == 'READY_FOR_RESULT' && request.resource.data.state == 'RESULT' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state'])));
    allow delete: if false;
    match /secrets/{uid} {
     allow get: if member(c) && active(c,r) && (request.auth.uid == uid || rnd(c,r).state == 'RESULT');
     allow list: if member(c) && active(c,r) && rnd(c,r).state == 'RESULT';
     allow create: if member(c) && active(c,r) && request.auth.uid == uid && uid in rnd(c,r).playerIds
      && rnd(c,r).state == 'DISTRIBUTING_NUMBERS'
      && request.resource.data.keys().hasOnly(['playerId','number']) && request.resource.data.playerId == uid
      && request.resource.data.number is int && request.resource.data.number >= 1 && request.resource.data.number <= 100;
     allow update: if false;
     allow delete: if cleanup(c,r);
    }
    match /ready/{uid} {
     allow read: if member(c);
     allow create: if member(c) && active(c,r) && request.auth.uid == uid && uid in rnd(c,r).playerIds
      && rnd(c,r).state == 'DISTRIBUTING_NUMBERS' && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == uid
      && getAfter(/databases/$(database)/documents/rooms/$(c)/rounds/$(r)/secrets/$(uid)).data.playerId == uid;
     allow update: if false;
     allow delete: if cleanup(c,r);
    }
    match /answers/{uid} {
     allow read: if member(c);
     allow create: if member(c) && active(c,r) && rnd(c,r).state == 'PRESENTING'
      && rnd(c,r).presentationOrder[rnd(c,r).currentPresentationIndex] == uid
      && request.resource.data.keys().hasOnly(['playerId','playerName','answer','skipped'])
      && request.resource.data.playerId == uid && text(request.resource.data.answer,100)
      && ((exists(playerDoc(c,uid)) && request.resource.data.playerName == get(playerDoc(c,uid)).data.name
        && ((request.auth.uid == uid && request.resource.data.skipped == false)
         || (host(c) && request.resource.data.skipped == true && request.resource.data.answer == 'Sem pista — jogador pulado')))
       // The presenter left the room: only the host may skip, with fixed texts.
       || (!exists(playerDoc(c,uid)) && host(c) && request.resource.data.skipped == true
        && request.resource.data.playerName == 'Jogador que saiu' && request.resource.data.answer == 'Sem pista — jogador pulado'));
     allow update: if false;
     allow delete: if cleanup(c,r);
    }
   }
  }
  // Catálogos de temas: leitura pública (inclusive jogos de um aparelho, sem login).
  // Só o script de administrador (npm run catalogs:publish) escreve; o cliente nunca.
  match /catalogs/{doc} {
   allow get, list: if true;
   allow write: if false;
  }
   // ===== Plano B, Manual Desmontado e Feira de Invenções (coleções mesas e mesaInvites) =====
  function mesaDoc(c) { return /databases/$(database)/documents/mesas/$(c); }
  function mesaRoom(c) { return get(/databases/$(database)/documents/mesas/$(c)).data; }
  function mesaRoomAfter(c) { return getAfter(/databases/$(database)/documents/mesas/$(c)).data; }
  function mesaMember(c) { return signed() && exists(/databases/$(database)/documents/mesas/$(c)/players/$(request.auth.uid)); }
  function mesaHost(c) { return mesaMember(c) && mesaRoom(c).hostId == request.auth.uid; }
  function mesaInvite(c) { return get(/databases/$(database)/documents/mesaInvites/$(c)).data; }
  function mesaInviteAfter(c) { return getAfter(/databases/$(database)/documents/mesaInvites/$(c)).data; }
  function mesaRound(c, r) { return get(/databases/$(database)/documents/mesas/$(c)/rounds/$(r)).data; }
  function mesaRoundAfter(c, r) { return getAfter(/databases/$(database)/documents/mesas/$(c)/rounds/$(r)).data; }
  function mesaFinal(p) { return p in ['reveal','done','result']; }
  function uniqueList(l, min, max) { return l is list && l.size() >= min && l.size() <= max && l.toSet().size() == l.size(); }
  // Lista nova = lista antiga + exatamente o próprio usuário.
  function addsSelf(before, after) {
   return after is list && after.size() == before.size() + 1 && after.hasAll(before)
    && request.auth.uid in after && !(request.auth.uid in before) && after.toSet().size() == after.size();
  }
  function hostGone(c, h) {
   return !exists(/databases/$(database)/documents/mesas/$(c)/players/$(h))
    || (get(/databases/$(database)/documents/mesas/$(c)/players/$(h)).data.connected == false
     && get(/databases/$(database)/documents/mesas/$(c)/players/$(h)).data.presenceAt is timestamp
     && request.time > get(/databases/$(database)/documents/mesas/$(c)/players/$(h)).data.presenceAt + duration.value(3, 'm'));
  }

  match /mesaInvites/{c} {
   allow get: if signed();
   allow list: if false;
   allow create: if signed() && c.matches('^[A-HJ-NP-Z2-9]{5}$')
    && request.resource.data.keys().hasOnly(['count','game'])
    && request.resource.data.count == 1 && request.resource.data.game in ['planb','manual','feira','ads']
    && mesaRoomAfter(c).hostId == request.auth.uid && mesaRoomAfter(c).game == request.resource.data.game
    && getAfter(/databases/$(database)/documents/mesas/$(c)/players/$(request.auth.uid)).data.uid == request.auth.uid;
   // Entrada: +1 vaga, no máximo 8, só no lobby.
   allow update: if signed() && resource.data.count < 8
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
    && request.resource.data.count == resource.data.count + 1
    && !exists(/databases/$(database)/documents/mesas/$(c)/players/$(request.auth.uid))
    && getAfter(/databases/$(database)/documents/mesas/$(c)/players/$(request.auth.uid)).data.uid == request.auth.uid
    && mesaRoom(c).phase == 'lobby';
   // Saída: -1 vaga, junto com a remoção do próprio jogador.
   allow update: if mesaMember(c) && resource.data.count > 0
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
    && request.resource.data.count == resource.data.count - 1
    && !existsAfter(/databases/$(database)/documents/mesas/$(c)/players/$(request.auth.uid));
   allow delete: if false;
  }

  match /mesas/{c} {
   allow read: if mesaMember(c);
   allow create: if signed() && c.matches('^[A-HJ-NP-Z2-9]{5}$')
    && request.resource.data.keys().hasOnly(['code','game','hostId','phase','gameNo','roundNo','currentRoundId','used','mode','inventors'])
    && request.resource.data.code == c && request.resource.data.hostId == request.auth.uid
    && request.resource.data.game in ['planb','manual','feira','ads'] && request.resource.data.phase == 'lobby'
    && request.resource.data.gameNo == 1 && request.resource.data.roundNo == 0
    && request.resource.data.currentRoundId == '' && request.resource.data.used == []
    && request.resource.data.get('mode','online') in ['online','presencial']
    && request.resource.data.get('inventors', 2) in [2, 3]
    && mesaInviteAfter(c).count == 1
    && getAfter(/databases/$(database)/documents/mesas/$(c)/players/$(request.auth.uid)).data.uid == request.auth.uid;
   // Opções do lobby (modo da Feira), antes da primeira rodada da partida.
   allow update: if mesaHost(c) && resource.data.phase == 'lobby' && resource.data.roundNo == 0
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mode','inventors'])
    && request.resource.data.get('mode','online') in ['online','presencial']
    && request.resource.data.get('inventors', 2) in [2, 3];
   // Nova partida na mesma sala.
   allow update: if mesaHost(c) && resource.data.phase == 'lobby'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gameNo','roundNo','currentRoundId','used'])
    && request.resource.data.gameNo == resource.data.gameNo + 1 && request.resource.data.roundNo == 0
    && request.resource.data.currentRoundId == '' && request.resource.data.used == [];
   // Abrir rodada: id determinístico "partida-rodada"; a rodada nasce no mesmo commit.
   allow update: if mesaHost(c) && resource.data.phase == 'lobby' && request.resource.data.phase == 'playing'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase','roundNo','currentRoundId','used'])
    && request.resource.data.roundNo == resource.data.roundNo + 1
    && request.resource.data.currentRoundId == string(resource.data.gameNo) + '-' + string(request.resource.data.roundNo)
    && request.resource.data.used.size() == resource.data.used.size() + 1 && request.resource.data.used.hasAll(resource.data.used)
    && existsAfter(/databases/$(database)/documents/mesas/$(c)/rounds/$(request.resource.data.currentRoundId));
   // Fim da rodada: volta ao lobby (novas entradas permitidas).
   allow update: if mesaMember(c) && resource.data.phase == 'playing' && request.resource.data.phase == 'lobby'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase'])
    && mesaFinal(mesaRoundAfter(c, resource.data.currentRoundId).phase);
   // Saída voluntária: passa o posto (se for o anfitrião) e volta ao lobby se ficar menos de 2.
   allow update: if mesaMember(c)
    && !existsAfter(/databases/$(database)/documents/mesas/$(c)/players/$(request.auth.uid))
    && mesaInviteAfter(c).count == mesaInvite(c).count - 1
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostId','phase'])
    && (request.resource.data.phase == resource.data.phase || (request.resource.data.phase == 'lobby' && mesaInviteAfter(c).count < 2))
    && ((resource.data.hostId != request.auth.uid && request.resource.data.hostId == resource.data.hostId)
     || (resource.data.hostId == request.auth.uid && ((mesaInviteAfter(c).count == 0 && request.resource.data.hostId == '')
      || (request.resource.data.hostId != request.auth.uid
       && existsAfter(/databases/$(database)/documents/mesas/$(c)/players/$(request.resource.data.hostId))))));
   // Anfitrião ausente há mais de 3 minutos (ou que saiu): um membro conectado assume.
   allow update: if mesaMember(c)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostId'])
    && request.resource.data.hostId == request.auth.uid && resource.data.hostId != request.auth.uid
    && get(/databases/$(database)/documents/mesas/$(c)/players/$(request.auth.uid)).data.connected == true
    && (resource.data.hostId == '' || hostGone(c, resource.data.hostId));
   allow delete: if false;

   match /players/{uid} {
    allow get: if signed() && (uid == request.auth.uid || mesaMember(c));
    allow list: if mesaMember(c);
    allow create: if signed() && uid == request.auth.uid
     && request.resource.data.keys().hasOnly(['uid','name','joinedAt','connected','presenceAt'])
     && request.resource.data.uid == uid && text(request.resource.data.name, 24)
     && request.resource.data.joinedAt == request.time && request.resource.data.presenceAt == request.time
     && request.resource.data.connected == true
     && ((!exists(/databases/$(database)/documents/mesaInvites/$(c))
       && mesaInviteAfter(c).count == 1 && mesaRoomAfter(c).hostId == uid)
      || (exists(/databases/$(database)/documents/mesaInvites/$(c))
       && mesaInvite(c).count < 8 && mesaInviteAfter(c).count == mesaInvite(c).count + 1
       && mesaRoom(c).phase == 'lobby'));
    allow update: if signed() && uid == request.auth.uid
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['connected','presenceAt'])
     && request.resource.data.connected is bool && request.resource.data.presenceAt == request.time;
    allow delete: if signed() && uid == request.auth.uid
     && mesaInviteAfter(c).count == mesaInvite(c).count - 1;
   }

   match /rounds/{r} {
    function rd() { return mesaRound(c, r); }
    function isCurrent() { return mesaRoom(c).currentRoundId == r; }
    function nd() { return request.resource.data; }
    allow read: if mesaMember(c);
    allow create: if mesaHost(c) && mesaRoom(c).phase == 'lobby'
     && mesaRoomAfter(c).currentRoundId == r && mesaRoomAfter(c).phase == 'playing'
     && nd().id == r && nd().no == mesaRoomAfter(c).roundNo && nd().game == mesaRoom(c).game
     && ((nd().game == 'planb' && planbCreate(c, r, nd()))
      || (nd().game == 'manual' && manualCreate(c, r, nd()))
      || (nd().game in ['feira','ads'] && feiraCreate(c, r, nd())));
    allow update: if mesaMember(c) && isCurrent()
     && ((rd().game == 'planb' && planbUpdate(rd(), nd()))
      || (rd().game == 'manual' && manualUpdate(c, r, rd(), nd()))
      || (rd().game in ['feira','ads'] && rd().mode == 'online' && feiraOnlineUpdate(c, r, rd(), nd()))
      || (rd().game in ['feira','ads'] && rd().mode == 'presencial' && feiraLiveUpdate(c, r, rd(), nd())));
    allow delete: if false;

    // Segredos lacrados (imprevisto, gabarito, autores): ninguém lê antes do fim da rodada.
    match /sealed/{s} {
     allow get: if mesaMember(c) && mesaFinal(rd().phase);
     allow list: if false;
     allow create: if mesaHost(c) && !exists(/databases/$(database)/documents/mesas/$(c)/rounds/$(r))
      && existsAfter(/databases/$(database)/documents/mesas/$(c)/rounds/$(r))
      && ((mesaRoundAfter(c, r).game == 'planb' && s == 'twist'
        && request.resource.data.keys().hasOnly(['twist']) && request.resource.data.twist in [0, 1, 2])
       || (mesaRoundAfter(c, r).game == 'manual' && s == 'solution'
        && request.resource.data.keys().hasOnly(['solution']) && uniqueList(request.resource.data.solution, 4, 6)
        && request.resource.data.solution.size() == mesaRoundAfter(c, r).size)
       );
     allow update, delete: if false;
    }

    // Plano B: escolha privada até a revelação, única e dentro do prazo.
    match /choices/{uid} {
     allow get: if mesaMember(c) && (uid == request.auth.uid || rd().phase == 'reveal');
     allow list: if mesaMember(c) && rd().phase == 'reveal';
     allow create: if mesaMember(c) && uid == request.auth.uid && rd().game == 'planb'
      && rd().phase == 'choose' && uid in rd().participants
      && request.time < rd().startedAt + duration.value(27, 's')
      && request.resource.data.keys().hasOnly(['uid','picks']) && request.resource.data.uid == uid
      && uniqueList(request.resource.data.picks, 2, 2)
      && request.resource.data.picks[0] is int && request.resource.data.picks[1] is int
      && request.resource.data.picks[0] >= 0 && request.resource.data.picks[0] <= 5
      && request.resource.data.picks[1] >= 0 && request.resource.data.picks[1] <= 5
      && request.auth.uid in mesaRoundAfter(c, r).confirmed;
     allow update, delete: if false;
    }
    // Manual Desmontado: bancada visível só para a própria equipe até o fim do desafio.
    match /benches/{t} {
     function team() { return t == 'A' ? rd().teamA : rd().teamB; }
     function sol() { return get(/databases/$(database)/documents/mesas/$(c)/rounds/$(r)/sealed/solution).data.solution; }
     allow get: if mesaMember(c) && rd().game == 'manual' && (request.auth.uid in team() || rd().phase == 'done');
     allow list: if false;
     allow create: if mesaHost(c) && !exists(/databases/$(database)/documents/mesas/$(c)/rounds/$(r))
      && mesaRoundAfter(c, r).game == 'manual' && t in ['A','B']
      && request.resource.data.keys().hasOnly(['team','members','slots','attempts','status','lastCorrect','solvedAt','tester'])
      && request.resource.data.team == t
      && request.resource.data.members == (t == 'A' ? mesaRoundAfter(c, r).teamA : mesaRoundAfter(c, r).teamB)
      && request.resource.data.tester in request.resource.data.members
      && request.resource.data.slots.size() == mesaRoundAfter(c, r).size
      && request.resource.data.slots.toSet() == [''].toSet()
      && request.resource.data.attempts == 0 && request.resource.data.status == 'open'
      && request.resource.data.lastCorrect == -1 && request.resource.data.solvedAt == null;
     // Mover peças: qualquer integrante, sem duplicar peça, só peças do desafio, dentro do prazo.
     allow update: if mesaMember(c) && rd().phase == 'build' && request.auth.uid in team()
      && resource.data.status == 'open' && request.time < rd().startedAt + duration.value(180, 's')
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots'])
      && request.resource.data.slots.size() == resource.data.slots.size()
      && request.resource.data.slots.removeAll(['']).toSet().size() == request.resource.data.slots.removeAll(['']).size()
      && sol().hasAll(request.resource.data.slots.removeAll(['']));
     // Testar: só o responsável da vez; o resultado precisa bater com o gabarito lacrado.
     allow update: if mesaMember(c) && rd().phase == 'build' && request.auth.uid == resource.data.tester
      && resource.data.status == 'open' && request.time < rd().startedAt + duration.value(182, 's')
      && !('' in resource.data.slots)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attempts','status','lastCorrect','solvedAt','tester'])
      && request.resource.data.attempts == resource.data.attempts + 1
      && request.resource.data.tester in resource.data.members
      && request.resource.data.lastCorrect == manualCorrect(resource.data.slots, sol())
      && ((resource.data.slots == sol() && request.resource.data.status == 'solved' && request.resource.data.solvedAt == request.time)
       || (resource.data.slots != sol() && request.resource.data.solvedAt == null
        && request.resource.data.status == (request.resource.data.attempts >= 2 ? 'failed' : 'open')));
     allow delete: if false;
    }
    // Pistas: cada pessoa lê só as suas até o fim do desafio.
    match /clues/{uid} {
     allow get: if mesaMember(c) && (uid == request.auth.uid || rd().phase == 'done');
     allow list: if mesaMember(c) && rd().phase == 'done';
     allow create: if mesaHost(c) && !exists(/databases/$(database)/documents/mesas/$(c)/rounds/$(r))
      && mesaRoundAfter(c, r).game == 'manual'
      && request.resource.data.keys().hasOnly(['uid','team','clues'])
      && request.resource.data.uid == uid && request.resource.data.team in ['A','B']
      && uid in (request.resource.data.team == 'A' ? mesaRoundAfter(c, r).teamA : mesaRoundAfter(c, r).teamB)
      && request.resource.data.clues is list && request.resource.data.clues.size() >= 1 && request.resource.data.clues.size() <= 6;
     allow update, delete: if false;
    }
    // Feira de Invenções: material secreto de cada inventor.
    match /materials/{uid} {
     allow get: if mesaMember(c) && (uid == request.auth.uid || rd().phase == 'result');
     allow list: if mesaMember(c) && rd().phase == 'result';
     allow create: if mesaHost(c) && !exists(/databases/$(database)/documents/mesas/$(c)/rounds/$(r))
      && mesaRoundAfter(c, r).game in ['feira','ads'] && uid in mesaRoundAfter(c, r).inventors
      && request.resource.data.keys().hasOnly(['uid','materialId']) && request.resource.data.uid == uid
      && text(request.resource.data.materialId, 40);
     allow update, delete: if false;
    }
    // Invenção escrita: id aleatório, sem autor. Visível na votação; o autor só no resultado.
    match /entries/{anon} {
     allow get: if mesaMember(c) && (rd().phase in ['vote','result']
      || get(/databases/$(database)/documents/mesas/$(c)/rounds/$(r)/authorOf/$(request.auth.uid)).data.anon == anon);
     allow list: if mesaMember(c) && rd().phase in ['vote','result'];
     allow create: if mesaMember(c) && rd().game in ['feira','ads'] && rd().mode == 'online' && rd().phase == 'create'
      && request.auth.uid in rd().inventors && request.time < rd().startedAt + duration.value(rd().secs + 2, 's')
      && request.resource.data.keys().hasOnly(['anon','name','how','slogan']) && request.resource.data.anon == anon
      && text(request.resource.data.name, 40) && text(request.resource.data.how, 200) && text(request.resource.data.slogan, 80)
      && getAfter(/databases/$(database)/documents/mesas/$(c)/rounds/$(r)/authors/$(anon)).data.uid == request.auth.uid;
     allow update, delete: if false;
    }
    match /authors/{anon} {
     allow get: if mesaMember(c) && rd().phase == 'result';
     allow list: if mesaMember(c) && rd().phase == 'result';
     allow create: if mesaMember(c) && rd().game in ['feira','ads'] && rd().phase == 'create'
      && request.resource.data.keys().hasOnly(['anon','uid']) && request.resource.data.anon == anon
      && request.resource.data.uid == request.auth.uid
      && !exists(/databases/$(database)/documents/mesas/$(c)/rounds/$(r)/authorOf/$(request.auth.uid))
      && getAfter(/databases/$(database)/documents/mesas/$(c)/rounds/$(r)/authorOf/$(request.auth.uid)).data.anon == anon
      && existsAfter(/databases/$(database)/documents/mesas/$(c)/rounds/$(r)/entries/$(anon));
     allow update, delete: if false;
    }
    match /authorOf/{uid} {
     allow get: if mesaMember(c) && (uid == request.auth.uid || rd().phase == 'result');
     allow list: if mesaMember(c) && rd().phase == 'result';
     allow create: if mesaMember(c) && uid == request.auth.uid && rd().game in ['feira','ads'] && rd().phase == 'create'
      && request.resource.data.keys().hasOnly(['uid','anon']) && request.resource.data.uid == uid
      && getAfter(/databases/$(database)/documents/mesas/$(c)/rounds/$(r)/authors/$(request.resource.data.anon)).data.uid == uid
      && uid in mesaRoundAfter(c, r).submitted;
     allow update, delete: if false;
    }
    // Voto online: escondido até o resultado; nunca na própria invenção.
    match /votes/{uid} {
     allow get: if mesaMember(c) && (uid == request.auth.uid || rd().phase == 'result');
     allow list: if mesaMember(c) && rd().phase == 'result';
     allow create: if mesaMember(c) && uid == request.auth.uid && rd().game in ['feira','ads'] && rd().phase == 'vote'
      && uid in rd().voters && request.time < rd().voteAt + duration.value(32, 's')
      && request.resource.data.keys().hasOnly(['uid','target']) && request.resource.data.uid == uid
      && exists(/databases/$(database)/documents/mesas/$(c)/rounds/$(r)/entries/$(request.resource.data.target))
      && get(/databases/$(database)/documents/mesas/$(c)/rounds/$(r)/authors/$(request.resource.data.target)).data.uid != uid
      && uid in mesaRoundAfter(c, r).voted;
     allow update, delete: if false;
    }
    // Voto presencial (Compro / Não compro): um por produto, só da plateia, no prazo.
    match /pvotes/{key} {
     allow get, list: if mesaMember(c) && rd().phase == 'result';
     allow create: if mesaMember(c) && rd().game in ['feira','ads'] && rd().mode == 'presencial' && rd().phase == 'vote'
      && request.auth.uid in rd().audience && request.time < rd().voteAt + duration.value(22, 's')
      && request.resource.data.keys().hasOnly(['inventor','voter','buy'])
      && request.resource.data.voter == request.auth.uid && request.resource.data.buy is bool
      && request.resource.data.inventor == rd().inventors[rd().current]
      && key == request.resource.data.inventor + '_' + request.auth.uid
      && request.auth.uid in mesaRoundAfter(c, r).pvoted;
     allow update, delete: if false;
    }
   }
  }

  // ----- Plano B -----
  function planbCreate(c, r, d) {
   return d.keys().hasOnly(['id','game','no','missionId','phase','participants','confirmed','startedAt'])
    && d.phase == 'choose' && d.confirmed == [] && d.startedAt == request.time
    && text(d.missionId, 40) && d.missionId in mesaRoomAfter(c).used
    && uniqueList(d.participants, 2, 8) && request.auth.uid in d.participants
    && existsAfter(/databases/$(database)/documents/mesas/$(c)/rounds/$(r)/sealed/twist);
  }
  function planbUpdate(o, d) {
   return (o.phase == 'choose' && d.phase == 'choose'
     && d.diff(o).affectedKeys().hasOnly(['confirmed'])
     && request.auth.uid in o.participants && addsSelf(o.confirmed, d.confirmed)
     && request.time < o.startedAt + duration.value(27, 's'))
    || (o.phase == 'choose' && d.phase == 'reveal'
     && d.diff(o).affectedKeys().hasOnly(['phase'])
     && (o.confirmed.toSet().hasAll(o.participants) || request.time >= o.startedAt + duration.value(25, 's')));
  }
  // ----- Manual Desmontado -----
  function manualCorrect(a, s) {
   return (a[0] == s[0] ? 1 : 0) + (a[1] == s[1] ? 1 : 0) + (a[2] == s[2] ? 1 : 0) + (a[3] == s[3] ? 1 : 0)
    + (s.size() > 4 && a[4] == s[4] ? 1 : 0) + (s.size() > 5 && a[5] == s[5] ? 1 : 0);
  }
  function manualCreate(c, r, d) {
   return d.keys().hasOnly(['id','game','no','challengeId','phase','teamA','teamB','size','startedAt'])
    && d.phase == 'build' && d.startedAt == request.time && d.size in [4, 5, 6]
    && text(d.challengeId, 40) && d.challengeId in mesaRoomAfter(c).used
    && uniqueList(d.teamA, 2, 4) && d.teamB is list && (d.teamB.size() == 0 || uniqueList(d.teamB, 2, 4))
    && d.teamA.toSet().intersection(d.teamB.toSet()).size() == 0
    && existsAfter(/databases/$(database)/documents/mesas/$(c)/rounds/$(r)/sealed/solution)
    && existsAfter(/databases/$(database)/documents/mesas/$(c)/rounds/$(r)/benches/A)
    && (d.teamB.size() == 0 || existsAfter(/databases/$(database)/documents/mesas/$(c)/rounds/$(r)/benches/B));
  }
  function manualBenchClosed(c, r, t) {
   return getAfter(/databases/$(database)/documents/mesas/$(c)/rounds/$(r)/benches/$(t)).data.status != 'open';
  }
  function manualUpdate(c, r, o, d) {
   return o.phase == 'build' && d.phase == 'done' && d.diff(o).affectedKeys().hasOnly(['phase'])
    && (request.time >= o.startedAt + duration.value(180, 's')
     || (manualBenchClosed(c, r, 'A') && (o.teamB.size() == 0 || manualBenchClosed(c, r, 'B'))));
  }
  // ----- Feira de Invenções -----
  function feiraCreate(c, r, d) {
   return d.mode == mesaRoom(c).get('mode', 'online') && text(d.problemId, 40) && d.problemId in mesaRoomAfter(c).used
    && d.startedAt == request.time && d.voteAt == null && uniqueList(d.inventors, 2, 8)
    && d.secs == (d.game == 'ads' ? 40 : 45)
    && ((d.mode == 'online' && d.keys().hasOnly(['id','game','no','mode','problemId','phase','inventors','voters','submitted','voted','startedAt','voteAt','secs'])
      && d.phase == 'create' && d.submitted == [] && d.voted == [] && d.voters is list && d.voters.size() <= 8
      && d.voters.toSet().size() == d.voters.size())
     || (d.mode == 'presencial' && d.keys().hasOnly(['id','game','no','mode','problemId','phase','inventors','audience','current','pvoted','startedAt','voteAt','secs'])
      && d.phase == 'prep' && d.current == 0 && d.pvoted == [] && d.inventors.size() <= 3
      && d.audience is list && d.audience.toSet().intersection(d.inventors.toSet()).size() == 0));
  }
  function feiraOnlineUpdate(c, r, o, d) {
   return (o.phase == 'create' && d.phase == 'create' && d.diff(o).affectedKeys().hasOnly(['submitted'])
     && request.auth.uid in o.inventors && addsSelf(o.submitted, d.submitted)
     && request.time < o.startedAt + duration.value(o.secs + 2, 's')
     && existsAfter(/databases/$(database)/documents/mesas/$(c)/rounds/$(r)/authorOf/$(request.auth.uid)))
    || (o.phase == 'create' && (o.submitted.toSet().hasAll(o.inventors) || request.time >= o.startedAt + duration.value(o.secs, 's'))
     && ((o.voters.size() > 0 && o.submitted.size() >= 2 && d.phase == 'vote' && d.voteAt == request.time
       && d.diff(o).affectedKeys().hasOnly(['phase','voteAt']))
      || ((o.voters.size() == 0 || o.submitted.size() < 2) && d.phase == 'result' && d.diff(o).affectedKeys().hasOnly(['phase']))))
    || (o.phase == 'vote' && d.phase == 'vote' && d.diff(o).affectedKeys().hasOnly(['voted'])
     && request.auth.uid in o.voters && addsSelf(o.voted, d.voted)
     && existsAfter(/databases/$(database)/documents/mesas/$(c)/rounds/$(r)/votes/$(request.auth.uid)))
    || (o.phase == 'vote' && d.phase == 'result' && d.diff(o).affectedKeys().hasOnly(['phase'])
     && (o.voted.toSet().hasAll(o.voters) || request.time >= o.voteAt + duration.value(30, 's')));
  }
  function feiraNext(o, d) {
   return (o.current + 1 < o.inventors.size() && d.phase == 'present' && d.current == o.current + 1)
    || (o.current + 1 >= o.inventors.size() && d.phase == 'result' && d.current == o.current);
  }
  function feiraLiveUpdate(c, r, o, d) {
   return (o.phase == 'prep' && d.phase == 'present' && d.current == 0
     && d.diff(o).affectedKeys().hasOnly(['phase','current']) && request.time >= o.startedAt + duration.value(o.secs, 's'))
    || (mesaHost(c) && o.phase == 'present' && d.phase == 'vote' && o.audience.size() > 0
     && d.diff(o).affectedKeys().hasOnly(['phase','voteAt','pvoted']) && d.voteAt == request.time && d.pvoted == [])
    || (mesaHost(c) && o.phase == 'present' && d.diff(o).affectedKeys().hasOnly(['phase','current']) && feiraNext(o, d))
    || (o.phase == 'vote' && d.phase == 'vote' && d.diff(o).affectedKeys().hasOnly(['pvoted'])
     && request.auth.uid in o.audience && addsSelf(o.pvoted, d.pvoted))
    || (o.phase == 'vote' && (o.pvoted.toSet().hasAll(o.audience) || request.time >= o.voteAt + duration.value(20, 's'))
     && d.diff(o).affectedKeys().hasOnly(['phase','current','pvoted']) && d.pvoted == [] && feiraNext(o, d));
  }

 }
}
