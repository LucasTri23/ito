rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function room(c) { return get(/databases/$(database)/documents/rooms/$(c)).data; }
  function member(c) { return signed() && exists(/databases/$(database)/documents/rooms/$(c)/players/$(request.auth.uid)); }
  function host(c) { return member(c) && room(c).hostId == request.auth.uid; }
  function active(c,r) { return room(c).status == 'PLAYING' && room(c).currentRoundId == r; }
  function rnd(c,r) { return get(/databases/$(database)/documents/rooms/$(c)/rounds/$(r)).data; }
  function cleanup(c,r) { return host(c) && rnd(c,r).state == 'RESULT' && getAfter(/databases/$(database)/documents/rooms/$(c)).data.currentRoundId != r; }
  function text(v,n) { return v is string && v.size() > 0 && v.size() <= n; }
  function permutation(a,b) { return a is list && a.size() == b.size() && a.toSet() == b.toSet(); }
  function ready(c,r,ids,i) { return ids.size() <= i || exists(/databases/$(database)/documents/rooms/$(c)/rounds/$(r)/ready/$(ids[i])); }
  function allReady(c,r,ids) { return ready(c,r,ids,0) && ready(c,r,ids,1) && ready(c,r,ids,2) && ready(c,r,ids,3) && ready(c,r,ids,4) && ready(c,r,ids,5) && ready(c,r,ids,6) && ready(c,r,ids,7); }
  function alibiMember(c) { return signed() && exists(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.auth.uid)); }
  function alibiRoom(c) { return get(/databases/$(database)/documents/alibiRooms/$(c)).data; }
  function alibiHost(c) { return alibiMember(c) && alibiRoom(c).hostId == request.auth.uid; }
  match /alibiInvites/{c} {
   allow get: if signed();
   allow list: if false;
   allow create: if signed() && c.matches('^[A-HJ-NP-Z2-9]{5}$')
    && request.resource.data.keys().hasOnly(['count','open'])
    && request.resource.data.count == 1 && request.resource.data.open == true
    && getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.hostId == request.auth.uid
    && getAfter(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.auth.uid)).data.uid == request.auth.uid;
   allow update: if signed() && resource.data.open == true && resource.data.count < 8
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
    && request.resource.data.count == resource.data.count + 1
    && !exists(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.auth.uid))
    && getAfter(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.auth.uid)).data.uid == request.auth.uid;
   allow update: if alibiMember(c) && resource.data.count > 0
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count','open'])
    && request.resource.data.count == resource.data.count - 1
    && request.resource.data.open == (request.resource.data.count > 0)
    && !existsAfter(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.auth.uid));
   allow delete: if false;
  }
  match /alibiRooms/{c} {
   allow read: if alibiMember(c);
   allow create: if signed() && request.resource.data.keys().hasOnly(['code','hostId','phase','mode'])
    && request.resource.data.code == c && request.resource.data.hostId == request.auth.uid
    && request.resource.data.phase == 'lobby' && request.resource.data.get('mode','online') in ['online','presencial']
    && getAfter(/databases/$(database)/documents/alibiInvites/$(c)).data.count == 1
    && getAfter(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.auth.uid)).data.uid == request.auth.uid;
   allow update: if alibiHost(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase','currentRoundId'])
    && ((resource.data.phase == 'lobby' && request.resource.data.phase == 'playing'
      && text(request.resource.data.currentRoundId,80)
      && getAfter(/databases/$(database)/documents/alibiRooms/$(c)/rounds/$(request.resource.data.currentRoundId)).data.phase == 'presentation')
     || (resource.data.phase == 'playing' && request.resource.data.phase == 'lobby'
      && request.resource.data.currentRoundId == resource.data.currentRoundId
      && getAfter(/databases/$(database)/documents/alibiRooms/$(c)/rounds/$(resource.data.currentRoundId)).data.phase in ['result','cancelled']));
   allow update: if alibiMember(c) && resource.data.phase == 'playing'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase'])
    && request.resource.data.phase == 'lobby'
    && getAfter(/databases/$(database)/documents/alibiRooms/$(c)/rounds/$(resource.data.currentRoundId)).data.phase == 'result';
   allow update: if alibiMember(c)
    && !existsAfter(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.auth.uid))
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hostId','phase'])
    && request.resource.data.phase == 'lobby'
    && getAfter(/databases/$(database)/documents/alibiInvites/$(c)).data.count == get(/databases/$(database)/documents/alibiInvites/$(c)).data.count - 1
    && (resource.data.phase == 'lobby' || getAfter(/databases/$(database)/documents/alibiRooms/$(c)/rounds/$(resource.data.currentRoundId)).data.phase == 'cancelled')
    && ((resource.data.hostId != request.auth.uid && request.resource.data.hostId == resource.data.hostId)
     || (resource.data.hostId == request.auth.uid && ((getAfter(/databases/$(database)/documents/alibiInvites/$(c)).data.count == 0 && request.resource.data.hostId == '')
      || (getAfter(/databases/$(database)/documents/alibiInvites/$(c)).data.count > 0 && request.resource.data.hostId != request.auth.uid
       && existsAfter(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.resource.data.hostId))))));
   allow delete: if false;
   match /clock/{uid} {
    allow read: if alibiMember(c);
    allow create, update: if alibiMember(c) && request.auth.uid == uid
     && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
    allow delete: if false;
   }
   // Reserved for the Firestore-only round implementation. A response or vote
   // is immutable and only its owner can read it until the relevant reveal.
   match /rounds/{r} {
    function currentRound() { return get(/databases/$(database)/documents/alibiRooms/$(c)).data.currentRoundId == r; }
    function game() { return get(/databases/$(database)/documents/alibiRooms/$(c)/rounds/$(r)).data; }
    allow read: if alibiMember(c);
    allow create: if alibiHost(c) && alibiRoom(c).phase == 'lobby'
     && getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.currentRoundId == r
     && getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.phase == 'playing'
     && request.resource.data.keys().hasOnly(['id','phase','mode','catalogId','situation','suspects','investigator','jurors','submitted','voted','customQuestion','startedAt','surpriseAt','voteStartedAt','history','used'])
     && request.resource.data.id == r && request.resource.data.phase == 'presentation'
     && request.resource.data.get('mode','online') == alibiRoom(c).get('mode','online')
     && text(request.resource.data.catalogId,80) && text(request.resource.data.situation,500)
     && request.resource.data.suspects is list && request.resource.data.suspects.size() == 2
     && request.resource.data.suspects.toSet().size() == 2
     && exists(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.resource.data.suspects[0]))
     && exists(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.resource.data.suspects[1]))
     && request.resource.data.jurors is list && request.resource.data.jurors.size() <= 5
     && request.resource.data.jurors.toSet().size() == request.resource.data.jurors.size()
     && request.resource.data.suspects.toSet().intersection(request.resource.data.jurors.toSet()).size() == 0
     && ((request.resource.data.investigator == null && request.resource.data.jurors.size() == 0
       && get(/databases/$(database)/documents/alibiInvites/$(c)).data.count == 2)
      || (request.resource.data.investigator is string && !(request.resource.data.investigator in request.resource.data.suspects)
       && !(request.resource.data.investigator in request.resource.data.jurors)
       && exists(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.resource.data.investigator))
       && get(/databases/$(database)/documents/alibiInvites/$(c)).data.count == request.resource.data.jurors.size() + 3))
     && request.resource.data.submitted == [] && request.resource.data.voted == []
     && request.resource.data.customQuestion == '' && request.resource.data.startedAt == null
     && request.resource.data.surpriseAt == null && request.resource.data.voteStartedAt == null
     && request.resource.data.history is map && request.resource.data.used is list;
    allow update: if alibiMember(c) && currentRound() && (
     (alibiHost(c) && resource.data.phase == 'presentation' && request.resource.data.phase == 'timer'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase','startedAt']) && request.resource.data.startedAt == request.time)
     || (resource.data.phase == 'timer' && request.time >= resource.data.startedAt + duration.value(30,'s')
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase','surpriseAt'])
      && ((resource.data.get('mode','online') == 'presencial' && request.resource.data.surpriseAt == null
        && ((resource.data.jurors.size() > 0 && request.resource.data.phase == 'oralSetup')
         || (resource.data.jurors.size() == 0 && request.resource.data.phase == 'oralFirst')))
       || (resource.data.get('mode','online') == 'online' && ((resource.data.investigator == null && request.resource.data.phase == 'answers' && request.resource.data.surpriseAt == null)
        || (resource.data.investigator != null && request.resource.data.phase == 'surprise' && request.resource.data.surpriseAt == request.time)))))
     || (resource.data.get('mode','online') == 'presencial' && resource.data.phase == 'oralSetup' && request.resource.data.phase == 'oralFirst'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase','customQuestion'])
      && request.resource.data.customQuestion is string && request.resource.data.customQuestion.size() <= 200
      && (request.auth.uid == resource.data.investigator || (alibiHost(c) && request.resource.data.customQuestion == '')))
     || (resource.data.get('mode','online') == 'presencial'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase'])
      && ((resource.data.phase == 'oralFirst' && request.resource.data.phase == 'oralSecond'
         && (alibiHost(c) || request.auth.uid == resource.data.suspects[0] || request.auth.uid == resource.data.investigator))
       || (resource.data.phase == 'oralSecond' && request.resource.data.phase == 'reveal'
         && (alibiHost(c) || request.auth.uid == resource.data.suspects[1] || request.auth.uid == resource.data.investigator))))
     || (resource.data.get('mode','online') == 'online' && resource.data.phase == 'surprise' && request.resource.data.phase == 'answers'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase','customQuestion'])
      && request.resource.data.customQuestion is string && request.resource.data.customQuestion.size() <= 200
      && ((request.auth.uid == resource.data.investigator && request.time < resource.data.surpriseAt + duration.value(15,'s'))
       || (request.time >= resource.data.surpriseAt + duration.value(15,'s') && request.resource.data.customQuestion == '')))
     || (resource.data.get('mode','online') == 'online' && resource.data.phase == 'answers' && request.resource.data.phase == 'answers'
      && request.auth.uid in resource.data.suspects && !(request.auth.uid in resource.data.submitted)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['submitted'])
      && request.resource.data.submitted.size() == resource.data.submitted.size() + 1
      && request.resource.data.submitted.toSet() == resource.data.submitted.toSet().union([request.auth.uid].toSet())
      && getAfter(/databases/$(database)/documents/alibiRooms/$(c)/rounds/$(r)/answers/$(request.auth.uid)).data.uid == request.auth.uid)
     || (resource.data.get('mode','online') == 'online' && resource.data.phase == 'answers' && request.resource.data.phase == 'reveal'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase'])
      && resource.data.submitted.toSet() == resource.data.suspects.toSet())
     || (alibiHost(c) && resource.data.phase == 'reveal' && request.resource.data.phase == 'vote'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase','voteStartedAt']) && request.resource.data.voteStartedAt == request.time)
     || (resource.data.phase == 'vote' && request.resource.data.phase == 'vote' && !(request.auth.uid in resource.data.voted)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voted'])
      && request.resource.data.voted.size() == resource.data.voted.size() + 1
      && request.resource.data.voted.toSet() == resource.data.voted.toSet().union([request.auth.uid].toSet())
      && getAfter(/databases/$(database)/documents/alibiRooms/$(c)/rounds/$(r)/votes/$(request.auth.uid)).data.uid == request.auth.uid)
     || (resource.data.phase == 'vote' && request.resource.data.phase == 'result'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase'])
      && ((resource.data.investigator == null && alibiHost(c))
       || (resource.data.investigator != null && (request.time >= resource.data.voteStartedAt + duration.value(30,'s')
        || (resource.data.jurors.size() == 0 && resource.data.investigator in resource.data.voted)
        || (resource.data.jurors.size() > 0 && resource.data.voted.toSet() == resource.data.jurors.toSet()))))
      && getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.phase == 'lobby')
     || (alibiHost(c) && !(resource.data.phase in ['result','cancelled']) && request.resource.data.phase == 'cancelled'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase'])
      && getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.phase == 'lobby')
     || (!(resource.data.phase in ['result','cancelled']) && request.resource.data.phase == 'cancelled'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phase'])
      && !existsAfter(/databases/$(database)/documents/alibiRooms/$(c)/players/$(request.auth.uid))
      && getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.phase == 'lobby'));
    allow delete: if false;
    match /answers/{uid} {
     allow get: if alibiMember(c) && currentRound()
      && (request.auth.uid == uid || game().phase in ['reveal','vote','result']);
     allow list: if alibiMember(c) && currentRound() && game().phase in ['reveal','vote','result'];
     allow create: if alibiMember(c) && currentRound() && request.auth.uid == uid
      && game().get('mode','online') == 'online' && game().phase == 'answers' && uid in game().suspects
      && request.resource.data.keys().hasOnly(['uid','values'])
      && request.resource.data.uid == uid && request.resource.data.values is list
      && request.resource.data.values.size() == 3
      && text(request.resource.data.values[0],500)
      && text(request.resource.data.values[1],500)
      && text(request.resource.data.values[2],500)
      && request.auth.uid in getAfter(/databases/$(database)/documents/alibiRooms/$(c)/rounds/$(r)).data.submitted;
     allow update, delete: if false;
    }
    match /votes/{uid} {
     allow get: if alibiMember(c) && currentRound()
      && (request.auth.uid == uid || game().phase == 'result');
     allow list: if alibiMember(c) && currentRound() && game().phase == 'result';
     allow create: if alibiMember(c) && currentRound() && request.auth.uid == uid
      && game().phase == 'vote'
      && (uid in game().jurors || (game().jurors.size() == 0
        && ((game().investigator != null && uid == game().investigator)
         || (game().investigator == null && uid == get(/databases/$(database)/documents/alibiRooms/$(c)).data.hostId))))
      && (game().investigator == null || request.time < game().voteStartedAt + duration.value(30, 's'))
      && request.resource.data.keys().hasOnly(['uid','choice']) && request.resource.data.uid == uid
      && request.resource.data.choice in ['colou','furado']
      && request.auth.uid in getAfter(/databases/$(database)/documents/alibiRooms/$(c)/rounds/$(r)).data.voted;
     allow update, delete: if false;
    }
   }
   match /players/{uid} {
    allow get: if signed() && (uid == request.auth.uid || alibiMember(c));
    allow list: if alibiMember(c);
    allow create: if signed() && uid == request.auth.uid
     && request.resource.data.keys().hasOnly(['uid','name','joinedAt'])
     && request.resource.data.uid == uid && text(request.resource.data.name,24)
     && request.resource.data.joinedAt == request.time
     && getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.phase == 'lobby'
     && getAfter(/databases/$(database)/documents/alibiInvites/$(c)).data.open == true
     && ((!exists(/databases/$(database)/documents/alibiInvites/$(c))
       && getAfter(/databases/$(database)/documents/alibiInvites/$(c)).data.count == 1
       && getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.hostId == uid)
      || (exists(/databases/$(database)/documents/alibiInvites/$(c))
       && get(/databases/$(database)/documents/alibiInvites/$(c)).data.count < 8
       && getAfter(/databases/$(database)/documents/alibiInvites/$(c)).data.count == get(/databases/$(database)/documents/alibiInvites/$(c)).data.count + 1));
    allow delete: if alibiMember(c) && request.auth.uid == uid
     && getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.phase == 'lobby'
     && (alibiRoom(c).hostId != uid || getAfter(/databases/$(database)/documents/alibiRooms/$(c)).data.hostId != uid)
     && getAfter(/databases/$(database)/documents/alibiInvites/$(c)).data.count == get(/databases/$(database)/documents/alibiInvites/$(c)).data.count - 1;
    allow update: if false;
   }
  }
  match /rooms/{c} {
   function playerDoc(c,u) { return /databases/$(database)/documents/rooms/$(c)/players/$(u); }
   // Host takeover after a prolonged disconnection: the host's player document
   // is gone, or it says connected == false and its server-stamped presenceAt is
   // older than 3 minutes (HOST_TAKEOVER_MINUTES in src/utils/game.ts).
   function hostAway(h) { return !exists(playerDoc(c,h))
    || (get(playerDoc(c,h)).data.connected == false && get(playerDoc(c,h)).data.get('presenceAt', null) is timestamp
     && request.time > get(playerDoc(c,h)).data.presenceAt + duration.value(3, 'm')); }
   function onlyKeys(k) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(k); }
   // Exact code lookup is necessary to join. Listing/enumeration is forbidden.
   allow get: if signed();
   allow list: if false;
   allow create: if signed() && c.matches('^[A-HJ-NP-Z2-9]{5}$')
    && request.resource.data.keys().hasOnly(['code','hostId','status','roundNo','currentRoundId','createdAt','mode','deal'])
    && ((request.resource.data.get('mode','ONLINE') == 'ONLINE' && !request.resource.data.keys().hasAny(['deal']))
     || (request.resource.data.get('mode','ONLINE') == 'IN_PERSON' && request.resource.data.deal == 0))
    && request.resource.data.code == c && request.resource.data.hostId == request.auth.uid
    && request.resource.data.status == 'LOBBY' && request.resource.data.roundNo == 0
    && request.resource.data.currentRoundId == '' && request.resource.data.createdAt == request.time;
   allow update: if host(c) && resource.data.get('mode','ONLINE') == 'ONLINE' && resource.data.status != 'CLOSED' && (
    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'CLOSED') ||
    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','roundNo','currentRoundId'])
     && request.resource.data.status == 'PLAYING' && request.resource.data.roundNo == resource.data.roundNo + 1
     && request.resource.data.currentRoundId == string(request.resource.data.roundNo)
     && (resource.data.status == 'LOBBY' || rnd(c,resource.data.currentRoundId).state == 'RESULT')
     && getAfter(/databases/$(database)/documents/rooms/$(c)/rounds/$(request.resource.data.currentRoundId)).data.state == 'WAITING_FOR_THEME'));
   // Host abandons the current round and returns to the lobby (a participant left, etc.).
   allow update: if host(c) && resource.data.get('mode','ONLINE') == 'ONLINE' && resource.data.status == 'PLAYING'
    && onlyKeys(['status','currentRoundId']) && request.resource.data.status == 'LOBBY' && request.resource.data.currentRoundId == '';
   // Voluntary host exit: in the same commit the host deletes its own player document
   // and hands hostId to another existing member (optionally returning to the lobby).
   allow update: if host(c) && resource.data.get('mode','ONLINE') == 'ONLINE' && resource.data.status != 'CLOSED'
    && onlyKeys(['hostId','status','currentRoundId'])
    && request.resource.data.hostId != request.auth.uid && request.resource.data.hostId is string
    && exists(playerDoc(c,request.resource.data.hostId)) && existsAfter(playerDoc(c,request.resource.data.hostId))
    && !existsAfter(playerDoc(c,request.auth.uid))
    && ((request.resource.data.status == resource.data.status && request.resource.data.currentRoundId == resource.data.currentRoundId)
     || (resource.data.status == 'PLAYING' && request.resource.data.status == 'LOBBY' && request.resource.data.currentRoundId == ''));
   // Takeover: a connected member claims hostId for itself while the current host is away.
   allow update: if member(c) && resource.data.get('mode','ONLINE') == 'ONLINE' && resource.data.status != 'CLOSED'
    && onlyKeys(['hostId']) && request.resource.data.hostId == request.auth.uid
    && resource.data.hostId != request.auth.uid
    && get(playerDoc(c,request.auth.uid)).data.connected == true
    && hostAway(resource.data.hostId);
   allow delete: if false;
   allow update: if host(c) && resource.data.get('mode','ONLINE') == 'IN_PERSON' && resource.data.status == 'LOBBY'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deal'])
    && request.resource.data.deal == resource.data.deal + 1;
   match /cards/{uid} {
    allow get: if member(c) && request.auth.uid == uid && room(c).get('mode','ONLINE') == 'IN_PERSON';
    allow list: if false;
    allow create, update: if member(c) && request.auth.uid == uid
     && room(c).get('mode','ONLINE') == 'IN_PERSON' && room(c).status == 'LOBBY'
     && request.resource.data.keys().hasOnly(['uid','deal','number'])
     && request.resource.data.uid == uid && room(c).deal > 0 && request.resource.data.deal == room(c).deal
     && request.resource.data.number is int && request.resource.data.number >= 1 && request.resource.data.number <= 100
     && (!exists(/databases/$(database)/documents/rooms/$(c)/cards/$(uid)) || resource.data.deal < room(c).deal);
    allow delete: if false;
   }
   match /players/{uid} {
    allow get: if signed() && (request.auth.uid == uid || member(c));
    allow list: if member(c);
    allow create: if signed() && request.auth.uid == uid
     && getAfter(/databases/$(database)/documents/rooms/$(c)).data.status == 'LOBBY'
     && request.resource.data.keys().hasOnly(['uid','name','connected','joinedAt','presenceAt'])
     && request.resource.data.uid == uid && text(request.resource.data.name,24)
     && request.resource.data.connected == true && request.resource.data.joinedAt == request.time
     && request.resource.data.get('presenceAt', request.time) == request.time;
    allow update: if member(c) && request.auth.uid == uid && room(c).status != 'CLOSED'
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['connected','presenceAt'])
     && request.resource.data.connected is bool
     && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['presenceAt']) || request.resource.data.presenceAt == request.time);
    allow delete: if host(c) && room(c).status == 'LOBBY' && uid != room(c).hostId;
    // Voluntary exit (ONLINE): a member removes itself. The host must hand over
    // hostId in the same commit, or close the room when it is the last one.
    allow delete: if member(c) && request.auth.uid == uid && room(c).get('mode','ONLINE') == 'ONLINE'
     && room(c).status != 'CLOSED'
     && (room(c).hostId != uid
      || getAfter(/databases/$(database)/documents/rooms/$(c)).data.hostId != uid
      || getAfter(/databases/$(database)/documents/rooms/$(c)).data.status == 'CLOSED');
   }
   match /rounds/{r} {
    allow read: if member(c);
    allow create: if host(c) && room(c).get('mode','ONLINE') == 'ONLINE' && request.resource.data.keys().hasOnly(['state','theme','lowLabel','highLabel','playerIds','presentationOrder','currentPresentationIndex','groupOrder','createdAt'])
     && getAfter(/databases/$(database)/documents/rooms/$(c)).data.currentRoundId == r
     && r == string(room(c).roundNo + 1)
     && (room(c).status == 'LOBBY' || rnd(c,room(c).currentRoundId).state == 'RESULT')
     && request.resource.data.state == 'WAITING_FOR_THEME'
     && request.resource.data.theme == '' && request.resource.data.lowLabel == '' && request.resource.data.highLabel == ''
     && request.resource.data.playerIds is list && request.resource.data.playerIds.size() >= 2 && request.resource.data.playerIds.size() <= 8
     && request.resource.data.playerIds.toSet().size() == request.resource.data.playerIds.size()
     && request.auth.uid in request.resource.data.playerIds
     && request.resource.data.presentationOrder == request.resource.data.playerIds && request.resource.data.groupOrder == request.resource.data.playerIds
     && request.resource.data.currentPresentationIndex == 0 && request.resource.data.createdAt == request.time;
    allow update: if host(c) && active(c,r) && (
     (resource.data.state == 'WAITING_FOR_THEME' && request.resource.data.state == 'DISTRIBUTING_NUMBERS'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','theme','lowLabel','highLabel'])
      && text(request.resource.data.theme,120) && text(request.resource.data.lowLabel,40) && text(request.resource.data.highLabel,40)) ||
     (resource.data.state == 'DISTRIBUTING_NUMBERS' && request.resource.data.state == 'PRESENTING'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','presentationOrder'])
      && permutation(request.resource.data.presentationOrder,resource.data.playerIds) && allReady(c,r,resource.data.playerIds)) ||
     (resource.data.state == 'PRESENTING'
      && exists(/databases/$(database)/documents/rooms/$(c)/rounds/$(r)/answers/$(resource.data.presentationOrder[resource.data.currentPresentationIndex]))
      && ((request.resource.data.state == 'PRESENTING' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentPresentationIndex'])
       && request.resource.data.currentPresentationIndex == resource.data.currentPresentationIndex + 1 && request.resource.data.currentPresentationIndex < resource.data.playerIds.size())
       || (request.resource.data.state == 'ORDERING' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state']) && resource.data.currentPresentationIndex == resource.data.playerIds.size() - 1))) ||
     (resource.data.state == 'ORDERING' && request.resource.data.state == 'ORDERING' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['groupOrder']) && permutation(request.resource.data.groupOrder,resource.data.playerIds)) ||
     (resource.data.state == 'ORDERING' && request.resource.data.state == 'READY_FOR_RESULT' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state'])) ||
     (resource.data.state == 'READY_FOR_RESULT' && request.resource.data.state == 'RESULT' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state'])));
    allow delete: if false;
    match /secrets/{uid} {
     allow get: if member(c) && active(c,r) && (request.auth.uid == uid || rnd(c,r).state == 'RESULT');
     allow list: if member(c) && active(c,r) && rnd(c,r).state == 'RESULT';
     allow create: if member(c) && active(c,r) && request.auth.uid == uid && uid in rnd(c,r).playerIds
      && rnd(c,r).state == 'DISTRIBUTING_NUMBERS'
      && request.resource.data.keys().hasOnly(['playerId','number']) && request.resource.data.playerId == uid
      && request.resource.data.number is int && request.resource.data.number >= 1 && request.resource.data.number <= 100;
     allow update: if false;
     allow delete: if cleanup(c,r);
    }
    match /ready/{uid} {
     allow read: if member(c);
     allow create: if member(c) && active(c,r) && request.auth.uid == uid && uid in rnd(c,r).playerIds
      && rnd(c,r).state == 'DISTRIBUTING_NUMBERS' && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == uid
      && getAfter(/databases/$(database)/documents/rooms/$(c)/rounds/$(r)/secrets/$(uid)).data.playerId == uid;
     allow update: if false;
     allow delete: if cleanup(c,r);
    }
    match /answers/{uid} {
     allow read: if member(c);
     allow create: if member(c) && active(c,r) && rnd(c,r).state == 'PRESENTING'
      && rnd(c,r).presentationOrder[rnd(c,r).currentPresentationIndex] == uid
      && request.resource.data.keys().hasOnly(['playerId','playerName','answer','skipped'])
      && request.resource.data.playerId == uid && text(request.resource.data.answer,100)
      && ((exists(playerDoc(c,uid)) && request.resource.data.playerName == get(playerDoc(c,uid)).data.name
        && ((request.auth.uid == uid && request.resource.data.skipped == false)
         || (host(c) && request.resource.data.skipped == true && request.resource.data.answer == 'Sem pista — jogador pulado')))
       // The presenter left the room: only the host may skip, with fixed texts.
       || (!exists(playerDoc(c,uid)) && host(c) && request.resource.data.skipped == true
        && request.resource.data.playerName == 'Jogador que saiu' && request.resource.data.answer == 'Sem pista — jogador pulado'));
     allow update: if false;
     allow delete: if cleanup(c,r);
    }
   }
  }
 }
}
